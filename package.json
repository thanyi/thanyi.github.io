{
  "name": "ethanyi-blog",
  "type": "module",
  "version": "7.0.0",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "node scripts/vendor-artitalk.mjs && hugo server -D",
    "build": "node scripts/vendor-artitalk.mjs && rm -rf dist public/pagefind && hugo --gc --minify && pagefind --site dist && node scripts/generate-legacy-urls.mjs",
    "preview": "python3 -m http.server 4173 --directory dist",
    "new": "node scripts/blog.mjs new",
    "publish": "node scripts/blog.mjs publish",
    "test": "node --test scripts/tests/*.test.mjs",
    "verify:migration": "python3 scripts/verify-migration.py",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "artitalk": "3.3.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "pagefind": "^1.5.2",
    "prettier": "3.9.3"
  },
  "private": true
}
