{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- $posts := where site.RegularPages "Section" "posts" -}}
{{- $posts = $posts.ByDate.Reverse -}}
{{- $latest := index ($posts.ByLastmod.Reverse | first 1) 0 -}}
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="zh-CN">
  <id>{{ site.BaseURL }}</id>
  <title>{{ site.Title | htmlEscape }}</title>
  <subtitle>{{ site.Params.description | htmlEscape }}</subtitle>
  <link href="{{ site.BaseURL }}" />
  <link href="{{ "atom.xml" | absURL }}" rel="self" type="application/atom+xml" />
  <updated>{{ $latest.Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</updated>
  <author><name>{{ site.Params.author | htmlEscape }}</name></author>
  {{- range $posts }}
  <entry>
    <id>{{ .Permalink }}</id>
    <title>{{ .Title | htmlEscape }}</title>
    <link href="{{ .Permalink }}" />
    <published>{{ .Date.Format "2006-01-02T15:04:05Z07:00" }}</published>
    <updated>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</updated>
    <summary>{{ .Description | htmlEscape }}</summary>
  </entry>
  {{- end }}
</feed>
