---
type Metric = "page_pv" | "site_pv" | "site_uv";

interface Props {
  metric: Metric;
}

const { metric } = Astro.props;
const labels = {
  page_pv: {
    label: "阅读",
    unit: "次",
    title: "文章被打开的次数，重复访问会累计",
  },
  site_pv: { label: "总访问", unit: "次", title: "全站页面被打开的总次数" },
  site_uv: { label: "访客", unit: "人", title: "不蒜子统计的全站访客数" },
};
const { label, unit, title } = labels[metric];
---

<span
  id={`busuanzi_container_${metric}`}
  class="inline-flex items-center gap-1 text-sm whitespace-nowrap"
  data-visit-count
  data-pagefind-ignore
  aria-busy="true"
  title={title}
>
  {label}
  <span id={`busuanzi_value_${metric}`} class="tabular-nums">—</span>
  {unit}
</span>
