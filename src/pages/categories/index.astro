---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
import migration from "@/data/migration.json";
import { postFilter } from "@/utils/postFilter";

const posts = (await getCollection("posts")).filter(postFilter);
const categories = migration.legacyPages.filter(
  page =>
    page.kind === "categories" && page.category && !page.path.includes("/page/")
);
---

<Layout title={`分类 | ${config.site.title}`}>
  <Header />
  <Main pageTitle="分类" pageDesc="按学习方向浏览笔记。">
    <ul class="my-8 grid gap-4 sm:grid-cols-2">
      {
        categories.map(category => (
          <li>
            <a
              class="border-border hover:text-accent flex justify-between rounded-lg border p-4"
              href={category.path}
            >
              <span>{category.title}</span>
              <span class="text-muted-foreground">
                {
                  posts.filter(post =>
                    post.data.categories.includes(category.title)
                  ).length
                }
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Main>
  <Footer />
</Layout>
