---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
import artitalk from "@/data/artitalk.json";
---

<Layout title={`说说 | ${config.site.title}`}>
  <Header />
  <Main pageTitle="说说" pageDesc="一些随手记下的片段。">
    <p id="artitalk-status" class="text-muted-foreground my-6" role="status">
      正在加载…
    </p>
    <noscript>开启 JavaScript 后可以查看说说。</noscript>
    <div
      id="artitalk_main"
      data-app-id={artitalk.appId}
      data-app-key={artitalk.appKey}
      data-astro-reload
    >
    </div>
  </Main>
  <Footer />
</Layout>

<script>
  function showUnavailable() {
    const status = document.querySelector<HTMLElement>("#artitalk-status");
    const target = document.querySelector<HTMLElement>("#artitalk_main");
    if (!status || !target) return;
    status.hidden = false;
    status.textContent = "说说暂时无法加载，请稍后再试。";
    target.hidden = true;
  }

  // The original backend is archived. Surface its async error in the page until
  // the owner restores the application, rather than leaving an empty widget.
  window.addEventListener("unhandledrejection", event => {
    if (
      document.querySelector("#artitalk_main") &&
      String(event.reason?.message ?? event.reason).includes(
        "The app is archived"
      )
    ) {
      event.preventDefault();
      showUnavailable();
    }
  });

  async function loadMoments() {
    const target = document.querySelector<HTMLElement>("#artitalk_main");
    const status = document.querySelector<HTMLElement>("#artitalk-status");
    if (!target || !status || target.dataset.loaded) return;
    target.dataset.loaded = "true";
    try {
      // Keep the existing public Artitalk application; its records live in LeanCloud.
      if (!window.Artitalk) {
        const script = document.createElement("script");
        script.src = "/vendor/artitalk-3.3.4.js";
        await new Promise<void>((resolve, reject) => {
          script.onload = () => resolve();
          script.onerror = reject;
          document.head.appendChild(script);
        });
      }
      if (!window.Artitalk) throw new Error("Artitalk did not load");
      new window.Artitalk({
        appId: target.dataset.appId,
        appKey: target.dataset.appKey,
      });
      status.hidden = true;
    } catch {
      showUnavailable();
    }
  }
  loadMoments();
  document.addEventListener("astro:page-load", loadMoments);
</script>
